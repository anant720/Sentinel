NODE_ENV=staging
PORT=3000

# PostgreSQL Staging URL
DATABASE_URL=postgresql://user:pass@pgbouncer:6432/sentinel_staging

# Redis Staging Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Security
JWT_SECRET=staging-supersecure-jwt-secret

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=5

# Threat Intelligence Thresholds
RISK_BLOCK_THRESHOLD=90
RISK_VERIFY_THRESHOLD=60

# Logging
LOG_LEVEL=debug
