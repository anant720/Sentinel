# ══════════════════════════════════════════════════════
#  KantCore — DEMO Environment Configuration
#  ⚠️  FOR TESTING/DEMO PURPOSES ONLY — NOT FOR PRODUCTION
# ══════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Authentication (demo keys — change before any real use)
JWT_SECRET=demo-jwt-secret-kantcore-2026-not-for-prod-x1
JWT_REFRESH_SECRET=demo-refresh-secret-kantcore-2026-not-for-prod-x2
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sentinel_core

# Redis (matches docker-compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
BCRYPT_SALT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=15m
MAX_FAILED_ATTEMPTS=5
Account_LOCKOUT_TIME=30m
