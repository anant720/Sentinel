NODE_ENV=production
PORT=3000

# PostgreSQL Production URL (to PgBouncer)
DATABASE_URL=postgresql://user:pass@pgbouncer:6432/sentinel

# Redis Production Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=production-supersecure-jwt-secret-rotate-me

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=5

# Threat Intelligence Thresholds
RISK_BLOCK_THRESHOLD=90
RISK_VERIFY_THRESHOLD=60

# Logging
LOG_LEVEL=info
