NODE_ENV=development
PORT=3000

# PostgreSQL Development URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sentinel

# Redis Development Configuration
REDIS_HOST=localhost
REDIS_PORT=6380

# Security
JWT_SECRET=development-supersecure-jwt-secret

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=5

# Threat Intelligence Thresholds
RISK_BLOCK_THRESHOLD=90
RISK_VERIFY_THRESHOLD=60

# Logging
LOG_LEVEL=debug
